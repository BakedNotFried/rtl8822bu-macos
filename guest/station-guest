#!/usr/bin/python3
"""Single-station backend for the attached 0bda:b812 adapter in the Linux guest."""
import os
import re
import select
import signal
import socket
import subprocess
import tempfile
import time
import tty
from contextlib import ExitStack
from pathlib import Path


PORT = "/dev/hvc1"
FREQUENCIES = range(2412, 2473, 5)
MAX_FRAME = 1514
IP, ARP = 0x0800, 0x0806
HEX_MAC = re.compile(r"(?:[0-9a-f]{2}:){5}[0-9a-f]{2}")


class SessionError(Exception):
    """Only fixed diagnostic codes belong in these exceptions."""


def write_all(fd, data):
    offset = 0
    while offset < len(data):
        size = os.write(fd, data[offset:])
        if not size:
            raise EOFError()
        offset += size


def join_request(fd):
    # Bytes after JOIN must wait for LINK. Read just the handshake line so
    # unrelated stream data can never become part of the secret.
    line = bytearray()
    while len(line) <= 135:
        chunk = os.read(fd, 1)
        if not chunk:
            raise EOFError()
        if chunk == b"\n":
            break
        line += chunk
    else:
        raise SessionError("invalid-request")
    match = re.fullmatch(rb"JOIN ([a-fA-F0-9]{2,64}) ([a-fA-F0-9]{64})", line)
    if not match or len(match[1]) % 2:
        raise SessionError("invalid-request")
    return match[1].lower(), match[2].lower()


def target_interface(root=Path("/sys/class/net")):
    matches = []
    for entry in root.iterdir():
        if not (entry / "phy80211").exists():
            continue
        device = (entry / "device").resolve()
        for parent in (device, *device.parents):
            if (parent / "idVendor").is_file():
                if ((parent / "idVendor").read_text().strip().lower() == "0bda" and
                    (parent / "idProduct").read_text().strip().lower() == "b812"):
                    matches.append(entry)
                break
    if len(matches) > 1:
        raise SessionError("multiple-adapters")
    return matches[0] if matches else None


def await_interface():
    deadline = time.monotonic() + 60
    while time.monotonic() < deadline:
        entry = target_interface()
        if entry is not None:
            return entry
        time.sleep(0.2)
    raise SessionError("adapter-unavailable")


def wpa_config(ssid_hex, psk_hex, control):
    frequencies = b" ".join(str(f).encode() for f in FREQUENCIES)
    return (b"ctrl_interface=" + os.fsencode(control) + b"\nupdate_config=0\n"
            b"network={\nssid=" + ssid_hex + b"\npsk=" + psk_hex +
            b"\nkey_mgmt=WPA-PSK\nproto=RSN\npairwise=CCMP\ngroup=CCMP\n"
            b"ieee80211w=0\nfreq_list=" + frequencies + b"\n}\n")


def start_supplicant(interface, ssid_hex, psk_hex, control):
    # Keep credentials inside this guest's process memory. Only the fd number
    # goes in argv; closing the descriptor releases the anonymous object.
    config = os.memfd_create("station-conf", flags=os.MFD_CLOEXEC)
    try:
        write_all(config, wpa_config(ssid_hex, psk_hex, control))
        os.lseek(config, 0, os.SEEK_SET)
        return subprocess.Popen(
            ["wpa_supplicant", "-Dnl80211", "-i", interface, "-c", f"/proc/self/fd/{config}"],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            pass_fds=(config,))
    finally:
        os.close(config)


def status(interface, control):
    reply = subprocess.run(["wpa_cli", "-p", control, "-i", interface, "status"],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=3)
    if reply.returncode != 0:
        return {}
    return dict(line.split(b"=", 1) for line in reply.stdout.splitlines() if b"=" in line)


def verify_association(fields, expected_mac):
    # The supplicant has a fresh config with exactly one network (ID 0),
    # created from the exact SSID octets in JOIN.
    try:
        return (fields[b"wpa_state"] == b"COMPLETED" and fields[b"id"] == b"0" and
                fields[b"key_mgmt"] == b"WPA2-PSK" and fields[b"pairwise_cipher"] == b"CCMP" and
                fields[b"group_cipher"] == b"CCMP" and int(fields[b"freq"]) in FREQUENCIES and
                fields[b"address"].lower() == expected_mac.encode() and
                HEX_MAC.fullmatch(fields[b"bssid"].decode("ascii")) is not None)
    except (KeyError, UnicodeError, ValueError):
        return False


def wait_association(supplicant, interface, control, mac_text):
    deadline = time.monotonic() + 45
    while time.monotonic() < deadline:
        if supplicant.poll() is not None:
            raise SessionError("supplicant-exited")
        fields = status(interface, control)
        if fields.get(b"wpa_state") == b"COMPLETED":
            if not verify_association(fields, mac_text):
                raise SessionError("association-mismatch")
            return
        time.sleep(0.25)
    raise SessionError("association-timeout")


def valid_frame(frame, mac, from_host):
    if not 14 <= len(frame) <= MAX_FRAME or frame[6] & 1 or frame[6:12] == bytes(6):
        return False
    if from_host:
        if frame[6:12] != mac:
            return False
    elif not frame[0] & 1 and frame[:6] != mac:
        return False
    kind = int.from_bytes(frame[12:14], "big")
    if kind == ARP:
        return (len(frame) >= 42 and frame[14:20] == b"\x00\x01\x08\x00\x06\x04" and
                frame[20:22] in (b"\x00\x01", b"\x00\x02") and frame[22:28] == frame[6:12])
    if kind != IP or len(frame) < 34 or frame[14] >> 4 != 4:
        return False
    ip_header = (frame[14] & 15) * 4
    ip_length = int.from_bytes(frame[16:18], "big")
    return ip_header >= 20 and ip_header <= ip_length <= len(frame) - 14


def host_frames(data):
    pos = 0
    while len(data) - pos >= 2:
        size = (data[pos] << 8) | data[pos + 1]
        if not 14 <= size <= MAX_FRAME:
            raise SessionError("bad-frame-size")
        if pos + 2 + size > len(data):
            break
        yield bytes(data[pos + 2:pos + 2 + size])
        pos += 2 + size
    del data[:pos]


def bridge(fd, sockets, supplicant, interface, control, mac_text):
    mac = bytes.fromhex(mac_text.replace(":", ""))
    incoming, outgoing = bytearray(), bytearray()
    os.set_blocking(fd, False)
    next_status = time.monotonic() + 5
    while supplicant.poll() is None:
        if time.monotonic() >= next_status:
            if not verify_association(status(interface, control), mac_text):
                return
            next_status = time.monotonic() + 5
        readers, writers, _ = select.select([fd, *sockets.values()],
                                            [fd] if outgoing else [], [], 1)
        if writers:
            try:
                sent = os.write(fd, outgoing[:32768])
            except BlockingIOError:
                sent = 0
            del outgoing[:sent]
        for source in readers:
            if source == fd:
                block = os.read(fd, 32768)
                if not block:
                    if incoming:
                        raise SessionError("short-host-frame")
                    return
                incoming.extend(block)
                for frame in host_frames(incoming):
                    if valid_frame(frame, mac, True):
                        kind = int.from_bytes(frame[12:14], "big")
                        try:
                            sockets[kind].send(frame)
                        except BlockingIOError:
                            pass  # bounded real-time queue
            else:
                frame, address = source.recvfrom(MAX_FRAME + 1)
                # Linux sockaddr_ll reports PACKET_OUTGOING for local traffic.
                if address[2] == socket.PACKET_OUTGOING or not valid_frame(frame, mac, False):
                    continue
                if len(outgoing) + len(frame) + 2 <= 256 * 1024:
                    outgoing.extend(len(frame).to_bytes(2,"big"))
                    outgoing.extend(frame)


def terminate(process):
    if process.poll() is None:
        process.terminate()
        try:
            process.wait(timeout=4)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()


def run():
    # hvc1 can be a tty; disable echo before any credential-bearing input.
    with ExitStack() as resources:
        fd = os.open(PORT, os.O_RDWR | os.O_NOCTTY)
        resources.callback(os.close,fd)
        if os.isatty(fd):
            tty.setraw(fd)
        linked = False
        try:
            adapter = await_interface()
            subprocess.run(["ip", "link", "set", "dev", adapter.name, "up"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           check=True, timeout=10)
            mac = (adapter / "address").read_text().strip().lower()
            if not HEX_MAC.fullmatch(mac) or int(mac[:2],16) & 1 or mac == "00:00:00:00:00:00":
                raise SessionError("bad-device-address")
            write_all(fd,b"READY\n")
            ssid, psk = join_request(fd)
            control = tempfile.mkdtemp(prefix="rtl-station-",dir="/run")
            supplicant = start_supplicant(adapter.name, ssid, psk, control)
            resources.callback(terminate,supplicant)
            del psk
            wait_association(supplicant, adapter.name, control, mac)
            interfaces = {}
            for kind in (IP,ARP):
                # Protocol zero at creation prevents even temporary reception
                # from another NIC. Bind selects this station and one EtherType.
                sock = resources.enter_context(socket.socket(socket.AF_PACKET,socket.SOCK_RAW,0))
                sock.bind((adapter.name,kind))
                sock.setblocking(False)
                interfaces[kind] = sock
            write_all(fd,b"LINK " + mac.encode() + b"\n")
            linked = True
            bridge(fd, interfaces, supplicant, adapter.name, control, mac)
        except SessionError as error:
            if not linked:
                write_all(fd,b"ERROR " + str(error).encode("ascii") + b"\n")
        except (OSError, subprocess.SubprocessError):
            if not linked:
                write_all(fd,b"ERROR guest-io\n")
        except EOFError:
            pass


if __name__ == "__main__":
    def stop(_signo, _frame):
        raise SystemExit(0)
    signal.signal(signal.SIGTERM,stop)
    signal.signal(signal.SIGHUP,stop)
    run()
